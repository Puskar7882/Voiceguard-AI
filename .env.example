# VoiceGuard AI - Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env itself.

PROJECT_NAME="VoiceGuard AI"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-random-32+-character-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DB_HOST=localhost
DB_PORT=3306
DB_USER=voiceguard
DB_PASSWORD="replace-with-a-strong-password"
DB_NAME=voiceguard_db
MYSQL_ROOT_PASSWORD="replace-with-a-strong-root-password"
DATABASE_URL=mysql+pymysql://voiceguard:replace-with-a-strong-password@localhost:3306/voiceguard_db

RAZORPAY_KEY_ID="your-razorpay-test-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

INFERENCE_MODEL_TYPE=hybrid_rawnet_spectral
PRIVACY_DISCARD_RAW_AUDIO=true